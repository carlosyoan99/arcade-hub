{
  "name": "@arcade/engine",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Arcade Engine — núcleo determinista de simulación 2D",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {

{
  "name": "arcade-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Arcade Engine — 32 juegos arcade deterministas y servidor de salas online",
  "type": "module",
  "workspaces": [
    "engine",
    "server",
    "protocol"
  ],
  "scripts": {
    "test": "npm test -w @arcade/engine",
    "test:server": "npm test -w @arcade/server",
    "test:e2e": "playwright test",
    "build": "npm run build -w @arcade/engine",
    "build:hub": "npm run build:hub -w @arcade/engine",
    "dev": "npm run dev -w @arcade/engine",
    "start": "npm run start -w @arcade/server",
    "typecheck": "tsc -p engine/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run test:server && npm run build && npm run build:hub"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "ws": "^8.21.3"
  }
}
